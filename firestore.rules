rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /community_hub/{messageId} {
      allow read: if request.auth != null;
      // Guideline 1.2: a user auto-restricted after repeated reports (see
      // banned_users below) cannot create new posts — their own client no
      // longer has write access, enforced server-side, not just hidden locally.
      allow create: if request.auth != null &&
        !exists(/databases/$(database)/documents/banned_users/$(request.auth.uid));
      allow update: if request.auth != null;
      // Users can immediately remove their own posts from the feed.
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Moderation reports (App Store Guideline 1.2): any signed-in user may file
    // a report or block record. Nobody can read or alter them from the client —
    // they exist so the developer can act on them within 24 hours via the
    // Firebase console, and the autoBanOnReports function (Admin SDK) reads
    // them to auto-restrict repeatedly-reported users.
    match /moderation_reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    // A restriction record for a user who crossed the report threshold.
    // Only written by the trusted autoBanOnReports Cloud Function (Admin SDK
    // bypasses rules); a client can only read its own record to show the
    // "you're restricted" message.
    match /banned_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
